{
  "name": "great-adventure-application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta --restart-tries 10 --restart-after 1000 \"tsx watch server/index.ts\" \"next dev\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -n api,web -c cyan,magenta \"npm run start:api\" \"next start\"",
    "start:api": "tsx server/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "concurrently": "^9.2.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
